{
  "name": "tcs-testes",
  "private": true,
  "type": "module",
  "description": "Testes das regras do Firestore no emulador (npm test) e utilitários de verificação.",
  "scripts": {
    "test": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-tcs \"node --test testes/regras.test.mjs\"",
    "emuladores": "firebase emulators:start --config ../firebase.json --only firestore,auth --project demo-tcs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "exceljs": "^4.4.0",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.11.0"
  }
}
