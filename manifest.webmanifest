{
  "name": "Notas TCS — envio de notas da obra",
  "short_name": "Notas TCS",
  "description": "Fotografe a nota recebida na obra e envie para o escritório conferir.",
  "lang": "pt-BR",
  "start_url": "captura.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#173B68",
  "theme_color": "#173B68",
  "icons": [
    { "src": "icones/notas-tcs-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icones/notas-tcs-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icones/notas-tcs-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icones/notas-tcs.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "captura.html?compartilhado=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [{ "name": "fotos", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".heic"] }]
    }
  }
}
